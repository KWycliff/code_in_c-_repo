1059:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_uart.c ****         (+) HAL_UART_TxCpltCallback()
1060:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_uart.c ****         (+) HAL_UART_RxHalfCpltCallback()
1061:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_uart.c ****         (+) HAL_UART_RxCpltCallback()
